# Bu dosya şablondur ve depoya girer; gerçek değerler .env içinde kalır.
# Kurulum:  cp .env.example .env  ve aşağıdaki boş alanları doldur.

# --- Postgres ---
# docker-compose bu üç değeri okur. Parolayı kendin üret, örnek bir değer
# kopyalama:  openssl rand -hex 16
POSTGRES_USER=uyarla
POSTGRES_DB=uyarla
POSTGRES_PASSWORD=

# Prisma bağlantı dizesi. Yukarıdaki üç değerle kendin oluştur.
# Biçim:  postgresql://<KULLANICI>:<PAROLA>@localhost:5432/<VERITABANI>
DATABASE_URL=

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Üretken model: OpenAI uyumlu endpoint (K-03) ---
# Yerelde LM Studio, üretimde OpenAI (DOG-42). Anahtar yalnızca barındırılan
# API için gerekli; yerelde boş bırak.
#   Üretim:  LLM_BASE_URL="https://api.openai.com/v1"  LLM_MODEL=<model adı>
# Not: istek temperature: 0 gönderiyor; bunu kabul etmeyen akıl yürütme
# modelleri 400 döner.
LLM_BASE_URL="http://localhost:1234/v1"
LLM_MODEL="google/gemma-4-e4b"
LLM_API_KEY=
LLM_TIMEOUT_MS="60000"

# --- Embedding: ayrı sunucu (K-12) ---
# Üretken modelden ayrı tutuluyor ki biri değişince diğeri etkilenmesin;
# anahtarı da ayrı, LLM_API_KEY'e düşmüyor.
#   Üretim:  EMBEDDING_BASE_URL="https://api.openai.com/v1"
#            EMBEDDING_MODEL="text-embedding-3-small"
# Model değişince skor eşiği (semanticThreshold) yeniden ölçülmeli.
EMBEDDING_BASE_URL="http://localhost:11434/v1"
EMBEDDING_MODEL="bge-m3"
EMBEDDING_API_KEY=

# --- Dosya depolama ---
STORAGE_DIR="./storage"

# Ortak dosya deposu (üretimde Cloudflare R2). S3_BUCKET tanımlıysa CV'ler
# yerel disk yerine buraya yazılır; web ve worker ayrı makinedeyken zorunlu.
# Bucket herkese açık olmamalı; token yalnızca bu bucket'ta Object Read & Write.
# S3_ENDPOINT="https://<hesap-id>.r2.cloudflarestorage.com"
# S3_BUCKET="uyarla-bucket"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Kimlik doğrulama
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Sosyal giriş (isteğe bağlı; ikisi de doluysa buton çalışır, değilse "yakında")
# Geri dönüş adresi: {BETTER_AUTH_URL}/api/auth/callback/{google|linkedin|github}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# E-posta (boşsa magic link terminale yazılır)
RESEND_API_KEY=
EMAIL_FROM=
# E-postadaki tek tıkla çıkış bağlantılarını imzalar (DOG-127). Web ve cron servisi
# aynı değeri kullanmalı; yoksa e-posta Hesabım bağlantısına düşer. Üret: openssl rand -base64 48
EMAIL_LINK_SECRET=
# Aktivasyon ve ürün haberi e-postaları (DOG-130). İYS kaydı ve hukuk kontrolünden
# önce açılmamalı; boşsa yalnızca işlem e-postaları ve hatırlatmalar gider.
PRODUCT_EMAILS_ENABLED=

# Yönetim sayfası (/admin, huni raporu). Virgülle ayrılmış e-postalar; boşsa kimse giremez.
ADMIN_EMAILS=

# Hata izleme (Sentry). Boşsa kapalı. Worker ve web sunucusu SENTRY_DSN'i,
# tarayıcı NEXT_PUBLIC_SENTRY_DSN'i okur; ikisine aynı DSN yazılır.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Önerilen ilanlar (DOG-67, deneme). Boşsa o kaynak atlanır.
# Jooble: anahtarı tr.jooble.org/api/about'tan al. Ücretsiz anahtar toplam
# 500 istekle sınırlı (ömür boyu); ürün içinde kullanım için ortaklık gerekir.
JOOBLE_API_KEY=
JOOBLE_API_URL="https://tr.jooble.org/api/"
# Careerjet: yayıncı anahtarı careerjet.com/partners/api'den. Her istekte
# aramayı yapan kullanıcının IP'si gönderilir (KVKK: gizlilik metnine eklenmeli).
# İstekler yalnızca panelde bildirilen sunucu IP'lerinden kabul edilir.
CAREERJET_API_KEY=
CAREERJET_LOCALE="tr_TR"
# Sonuçların gösterildiği sayfa; Referer olarak gider (yoksa 403).
CAREERJET_PAGE_URL="https://uyarla.com.tr/dashboard"

# Tarayıcı eklentisi (DOG-71). Eklentinin açtığı sekme analizi kendiliğinden
# başlatmadan önce jetonu bu kimliklere soruyor; boşsa kendiliğinden başlatma
# kapalı, form yine doluyor. Virgülle ayrılır: geliştirme kimliği (manifest
# anahtarından, `pnpm --filter @uyarla/extension id`) ve mağaza kimliği.
NEXT_PUBLIC_EXTENSION_IDS="lggfjpmepigbmdfigppmfpppkhfahbka"

# Ödeme (DOG-34): Polar. Önce sandbox; üretime geçiş POLAR_SERVER=production.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER="sandbox"
# Polar ürün kimlikleri; boş olan paket gösterilmez.
POLAR_PRODUCT_WEEK=
POLAR_PRODUCT_MONTH=
POLAR_PRODUCT_QUARTER=
# Paket ekranında gösterilen TL fiyatlar (ödeme tutarı Polar'dan): "week:149, month:349, quarter:799"
PLAN_PRICES_TRY=
