generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  createdAt     DateTime     @default(now())
  resumes       Resume[]
  name          String
  emailVerified Boolean      @default(false)
  image         String?
  updatedAt     DateTime     @updatedAt
  isAnonymous   Boolean?     @default(false)
  sessions      Session[]
  accounts      Account[]
  analyses      Analysis[]
  jobPostings   JobPosting[]

  // Onboarding (DOG-50). Boşsa kayıtlı kullanıcıya onboarding gösterilir;
  // tamamlanınca ya da atlanınca doluyor.
  onboardedAt DateTime?
  goal        Goal?
  targetRole  String?
  // İndirilen CV'nin iletişim satırı için (DOG-58); boşsa eklenmiyor.
  phone       String?
  // Başvuru hatırlatmaları (DOG-98, DOG-128): takip, mülakat, son başvuru
  // tarihi. Hesabım'dan ya da e-postadaki bağlantıyla kapatılabiliyor.
  applicationReminders Boolean @default(true)
  // Erişim dönemi bilgileri (DOG-129): "dönemin bitmesine 2 gün kaldı".
  accessUpdates        Boolean @default(true)
  // Ürün haberleri ve öneriler (DOG-130): açık onayla, varsayılan kapalı.
  // Onayın geçmişi EmailConsent'te.
  productNews          Boolean @default(false)

  accessPasses AccessPass[]
  emailLogs    EmailLog[]
  emailConsents EmailConsent[]
  /// "Tüm ilanlarda hariç tut" listesi (DOG-90).
  excludedConcepts ExcludedConcept[]
  // LinkedIn profil denetimi (DOG-157); son 5 tarama.
  linkedinAudits LinkedInAudit[]
}

model Resume {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  filePath  String
  rawText   String       @db.Text
  status    ResumeStatus @default(uploaded)
  createdAt DateTime     @default(now())

  // CV kütüphanesi (DOG-50). savedAt doluysa kütüphanede; kaldırma yalnızca
  // bunu temizler, bağlı analizler kalır.
  label     String?
  fileName  String?
  savedAt   DateTime?
  isDefault Boolean         @default(false)
  versions  ResumeVersion[]
  // LinkedIn profil raporu (DOG-69): bu CV LinkedIn'den indirilen PDF'se,
  // seçilen ilanlara göre ortak eksikler ve profil kontrolleri.
  linkedinReport Json?
}

enum ResumeStatus {
  uploaded
  parsed
  failed
}

enum Goal {
  career_change
  first_job
  promotion
  exploring
}

model ResumeVersion {
  id        String              @id @default(cuid())
  resumeId  String
  resume    Resume              @relation(fields: [resumeId], references: [id])
  profile   Json
  source    ResumeVersionSource
  versionNo Int
  createdAt DateTime            @default(now())

  // Ayrıştırılmış profili üreten model + prompt özeti (DOG-59). Aynı anahtarla
  // üretilmiş "parsed" sürüm yeni analizde yeniden kullanılıyor; eski kayıtlarda
  // boş ve yeniden kullanılmıyor.
  parserKey String?
  analyses  Analysis[]

  // Bu sürümü üreten uyarlama(lar). Adlandırılmış ilişki: Adaptation hem
  // Analysis'e hem buraya bağlanıyor ve Prisma ikisini ayırt edebilmeli.
  adaptations Adaptation[] @relation("AdaptedFrom")

  @@unique([resumeId, versionNo])
}

enum ResumeVersionSource {
  parsed
  adapted
}

model JobPosting {
  id String @id @default(cuid())

  // Kullanıcının yapıştırdığı metni tutuyor ve marka rehberi "istediğin an
  // silebilirsin" diyor; sahipsiz satır o sözü tutulamaz kılar (spec §5).
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Sprint 1'de ihtiyaç yoktu; Sprint 2'de özet yeniden yazımı pozisyon
  // adını istiyor (spec §6.1). Mevcut kayıtlar boş kalıyor.
  position String  @default("")
  // İlan çıkarımının bulduğu şirket (DOG-64): panoda ve ön yazıda kullanılıyor.
  // Eski kayıtlarda ve şirket yazmayan ilanlarda boş.
  company  String?

  rawText      String     @db.Text
  requirements Json
  language     String
  seniority    String?
  // Son başvuru tarihi (DOG-120): ilanda açıkça yazıyorsa, gün olarak.
  // Eski kayıtlarda ve tarih yazmayan ilanlarda boş.
  deadline     DateTime?  @db.Date
  // İlanın adresi (DOG-95): platforma özel ipucu için. Sorgu kısmı atılmış;
  // metni yapıştırılan ilanlarda boş.
  sourceUrl    String?
  createdAt    DateTime   @default(now())
  analyses     Analysis[]
}

model Analysis {
  id String @id @default(cuid())

  // Sahiplik zincirden türetilemiyor: resumeVersionId nullable ve çıkarım
  // patlayan analizler ResumeVersion üretmiyor, sahipsiz kalırlardı (spec §5).
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Nullable: CV çıkarımı başarısız olursa ResumeVersion hiç oluşmaz, ama
  // spec §11 başarısız işlerin de Analysis kaydı yazmasını istiyor.
  resumeVersionId String?
  resumeVersion   ResumeVersion? @relation(fields: [resumeVersionId], references: [id])

  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id])

  score  Float?
  result Json?

  // Ölçüm alanları (K-03): model değiştiğinde karşılaştırma verisi
  // kendiliğinden birikir.
  modelId    String
  durationMs Int?
  tokenUsage Int?

  status     AnalysisStatus @default(running)
  errorClass String?
  createdAt  DateTime       @default(now())

  adaptation Adaptation?

  // Başvuru panosu. Her tamamlanmış analiz bir başvuru adayı: aynı CV'nin
  // aynı ilana göre değerlendirilmesi. Ayrı bir Application tablosu yerine
  // burada, çünkü ikisi bire bir ve pano analiz verisinin (skor, pozisyon,
  // uyarlama) tamamını zaten buradan okuyor.
  stage          ApplicationStage @default(saved)
  stageChangedAt DateTime?
  note           String?          @db.Text
  // Mülakat tarihi (DOG-98); kullanıcı panodan giriyor.
  interviewAt    DateTime?
  // "Başvurdum"dan sonra durum değişmediyse gönderilen takip hatırlatması
  // (DOG-98). Doluysa aynı başvuru için bir daha gönderilmiyor.
  reminderSentAt DateTime?
  // Takip mesajı ve teşekkür notu taslakları (DOG-117): [{ id, kind,
  // channel, status, subject, text, verification, createdAt }]. Taslak; biz
  // göndermiyoruz. Eski kayıtlarda boş.
  followUps      Json?
  // Mülakat hazırlık paketi (DOG-118): { status, createdAt, attempts, prep }.
  // Eski kayıtlarda boş.
  interviewPrep  Json?
  // Başvuru formu yanıtları (DOG-123): soru, sınır ve CV'ye dayanan yanıt.
  formAnswers    Json?

  @@index([resumeVersionId, jobPostingId])
  @@index([userId])
}

/// Başvuru panosunun sütunları.
enum ApplicationStage {
  saved // skor alındı, henüz başvurulmadı
  applied
  interview
  offer
  rejected
}

enum AnalysisStatus {
  running
  done
  failed
}

model Adaptation {
  id String @id @default(cuid())

  // Nullable değil ve benzersiz: bir analizin tek uyarlaması olur. Kullanıcı
  // farklı sonuç istiyorsa analizi yeniden çalıştırır; birden çok uyarlama
  // tutmak hangisinin indirildiğini izlemeyi gerektirir ve Sprint 2'de
  // bunun bir karşılığı yok (spec §5).
  analysisId String   @unique
  analysis   Analysis @relation(fields: [analysisId], references: [id])

  /// Çalışma hâli: madde bazında özgün, yeniden yazım, doğrulama, karar.
  /// Tek Json çünkü madde kararları sık güncelleniyor ve hepsi birlikte
  /// okunuyor; ayrı tabloya bölmenin kazandıracağı sorgulanabilirlik
  /// Sprint 2'de kullanılmıyor.
  draft Json

  /// Ön yazı: { durum: "running" | "done" | "failed", paragraflar, … }.
  /// Taslaktan ayrı sütun: taslak madde kararlarıyla sürekli okunup
  /// yeniden yazılıyor, ön yazı işi aynı alana yazsaydı eşzamanlı iki yazım
  /// birbirinin değişikliğini silebilirdi.
  coverLetter Json?

  /// Kabul edilenlerden üretilen nihai sürüm; indirme anında doluyor.
  resumeVersionId String?
  resumeVersion   ResumeVersion? @relation("AdaptedFrom", fields: [resumeVersionId], references: [id])

  status     AdaptationStatus @default(running)
  modelId    String
  durationMs Int?
  tokenUsage Int?
  errorClass String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

enum AdaptationStatus {
  running
  draft // yeniden yazım bitti, kullanıcı kararları bekleniyor
  ready // uyarı taşıyan maddelerin hepsi karara bağlandı
  failed
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum AccessPassStatus {
  active
  refunded
}

/// Ücretli erişim dönemi (DOG-34). Tek seferlik paket; otomatik yenileme yok.
/// Polar sipariş kimliği tekil: aynı ödeme bildirimi iki kez dönem açmaz.
model AccessPass {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            String
  startsAt        DateTime
  endsAt          DateTime
  providerOrderId String           @unique
  status          AccessPassStatus @default(active)
  createdAt       DateTime         @default(now())

  @@index([userId, endsAt])
}

/// Kullanıcının bütün ilanlarda hariç tuttuğu kavramlar (DOG-90). Bir
/// gereksinimin bütün kavramları listedeyse sonraki analizlerde otomatik
/// işaretli geliyor; eski analizlere dokunulmuyor.
model ExcludedConcept {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// conceptKey(term): Türkçe küçük harf, boşluk sadeleştirilmiş.
  key       String
  /// Ekranda gösterilen hâli.
  term      String
  createdAt DateTime @default(now())

  @@unique([userId, key])
}

/// Gönderilen e-postalar (DOG-128). Aynı e-postanın iki kez gitmemesi
/// (userId + kind + refId tekil) ve sıklık sınırı (işlem dışı e-postalarda
/// günde 1, haftada 3) için. İçerik saklanmıyor.
model EmailLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// interview_reminder, deadline_reminder, application_followup, access_ending, …
  kind       String
  /// transactional, applicationReminders, accessUpdates, productNews
  category   String
  /// Neyle ilgili: analiz ya da erişim dönemi kimliği; yoksa boş.
  refId      String   @default("")
  /// Resend'in ileti kimliği.
  providerId String?
  sentAt     DateTime @default(now())

  @@unique([userId, kind, refId])
  @@index([userId, sentAt])
}

/// Ürün haberleri onayının geçmişi (DOG-130). Yalnızca ekleniyor: verilen ve
/// geri alınan her onay bir satır. 6563 sayılı Kanun ve İYS için onayın ne
/// zaman, nereden ve hangi metinle verildiği kanıtlanabilmeli.
model EmailConsent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     String   @default("productNews")
  granted     Boolean
  /// account (Hesabım), unsubscribe (e-postadaki bağlantı)
  source      String
  /// Onay metninin sürümü (server/email/consent.ts).
  textVersion String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

/// LinkedIn profil denetimi: profil, teşhis ve yazımlar (DOG-157).
model LinkedInAudit {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      LinkedInAuditSource
  /// PDF yolunda kütüphanedeki CV.
  resumeId    String?
  /// LinkedInProfileData; PDF yolunda okuma bitene kadar boş.
  profile     Json?
  targetRole  String?
  analysisIds String[]
  status      LinkedInAuditStatus @default(running)
  /// reading | checking | writing; bitince null.
  stage       String?
  report      Json?
  rewrites    Json?
  /// Düşen yazımların yeniden denenme sayısı; en çok 3.
  retries     Int                 @default(0)
  createdAt   DateTime            @default(now())
  /// Worker her aşamada yazıyor; takılma süresi buradan ölçülüyor (yeniden denemede de sıfırlanıyor).
  updatedAt   DateTime            @default(now()) @updatedAt

  @@index([userId, createdAt])
}

enum LinkedInAuditSource {
  extension
  pdf
}

enum LinkedInAuditStatus {
  running
  done
  failed
}
