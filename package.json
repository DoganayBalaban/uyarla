{
  "name": "uyarla",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm run \"/^dev:(web|worker)$/\"",
    "dev:web": "pnpm --filter @uyarla/web exec dotenv -e ../../.env -- next dev -p 3001",
    "dev:worker": "pnpm --filter @uyarla/worker exec -- tsx watch --env-file=../../.env src/index.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.7.0"
  }
}
