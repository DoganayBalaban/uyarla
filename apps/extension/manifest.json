{
  "manifest_version": 3,
  "name": "uyarla — ilana uyumunu ölç",
  "short_name": "uyarla",
  "version": "0.4.0",
  "description": "İş ilanlarında ve kendi LinkedIn profilinde tek tıkla uyarla: ilan sayfasında düğme, simgede menü.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications",
    "storage"
  ],
  "externally_connectable": {
    "matches": [
      "https://uyarla.com.tr/*",
      "http://localhost:3000/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://linkedin.com/*",
        "https://*.linkedin.com/*",
        "https://kariyer.net/*",
        "https://*.kariyer.net/*",
        "https://yenibiris.com/*",
        "https://*.yenibiris.com/*",
        "https://secretcv.com/*",
        "https://*.secretcv.com/*",
        "https://eleman.net/*",
        "https://*.eleman.net/*",
        "https://tr.indeed.com/*",
        "https://*.tr.indeed.com/*",
        "https://greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://lever.co/*",
        "https://*.lever.co/*",
        "https://myworkdayjobs.com/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "uyarla",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
