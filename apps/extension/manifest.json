{
  "manifest_version": 3,
  "name": "uyarla — ilana uyumunu ölç",
  "short_name": "uyarla",
  "version": "0.2.0",
  "description": "Açık ilan sayfasını tek tıkla uyarla'ya gönder; CV'nin bu ilana uyumunu gör.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications",
    "storage"
  ],
  "externally_connectable": {
    "matches": [
      "https://uyarla.com.tr/*",
      "http://localhost:3000/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bu ilana uyumumu ölç",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
