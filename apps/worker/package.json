{
  "name": "@uyarla/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./queue": "./src/queue.ts",
    "./adapt-queue": "./src/adapt-queue.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node scripts/build.mjs && node --enable-source-maps dist/index.mjs",
