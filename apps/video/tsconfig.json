{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/*": ["../web/src/*"] },
    "types": ["react", "react-dom"]
  },
  "include": ["src", "remotion.config.ts", "../web/src/**/*.d.ts"]
}
