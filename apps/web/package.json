{
  "name": "@uyarla/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @uyarla/db generate && next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts",
    "migrate:json-keys": "dotenv -e ../../.env -- tsx scripts/migrate-json-keys.ts",
    "cleanup:anonymous": "dotenv -e ../../.env -- tsx scripts/cleanup-anonymous-users.ts",
    "cleanup:cron": "tsx scripts/cleanup-anonymous-users.ts --delete && tsx scripts/daily-emails.ts --send",
    "funnel": "dotenv -e ../../.env -- tsx scripts/funnel.ts",
    "exclusion-reports": "dotenv -e ../../.env -- tsx scripts/exclusion-reports.ts",
    "backfill:excluded": "dotenv -e ../../.env -- tsx scripts/backfill-excluded-scores.ts",
    "emails:daily": "dotenv -e ../../.env -- tsx scripts/daily-emails.ts",
    "calibration": "dotenv -e ../../.env -- tsx scripts/calibration.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@polar-sh/sdk": "1.0.2",
    "@sentry/nextjs": "^11.6.0",
    "@tanstack/react-query": "^5.104.0",
    "@uyarla/core": "workspace:*",
    "@uyarla/db": "workspace:*",
    "@uyarla/fonts": "workspace:*",
    "@uyarla/worker": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.20.0",
    "better-auth": "^1.7.6",
    "bullmq": "^5.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ioredis": "^5.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.89.0",
    "recharts": "3.8.0",
    "resend": "^6.29.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
